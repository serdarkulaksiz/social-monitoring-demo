# social-incident-monitor configuration template.
# Copy to .env and replace the placeholder values. Never commit .env.

# Required. Shared secret the collector sends in the X-API-Key header (>= 24 characters).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MONITOR_API_KEY=change-me-generate-a-random-value-of-32-chars

# HTTP listener. Keep 127.0.0.1 unless the collector runs on another host.
MONITOR_HOST=127.0.0.1
MONITOR_PORT=8000

# Runtime JSONL data directory (created automatically; never commit it).
MONITOR_DATA_DIR=data
MONITOR_LOG_LEVEL=INFO

# true only for a separate demo instance fed with synthetic data.
MONITOR_ACCEPT_SYNTHETIC=false

# Classification: hybrid (rules + the plain-Python text model, see docs/MODEL.md) or rule_based (rules only).
# "llm" requires a provider adapter, which is not included.
MONITOR_CLASSIFIER=hybrid
# MONITOR_CLASSIFICATION_RULES_PATH=config/rules_tr.json
# Text model file for hybrid (default: <data_dir>/models/active.json written by promote-model;
# until a model is promoted, the model bundled with the code is used).
# MONITOR_TEXT_MODEL_PATH=data/models/active.json
# MONITOR_BUNDLED_TEXT_MODEL=true
# active = the model may change the rules' answer; shadow = the model is computed and shown but posts keep the rules' answer.
MONITOR_TEXT_MODEL_MODE=active
MONITOR_TEXT_MODEL_RESCUE_P=0.6
MONITOR_TEXT_MODEL_VETO_P=0.7

# Detection windows in minutes and thresholds as window:warning:critical (distinct users).
MONITOR_DETECTION_WINDOWS_MINUTES=5,15,30
MONITOR_DETECTION_THRESHOLDS=15:10:25
MONITOR_INCIDENT_RESOLVE_AFTER_MINUTES=30
MONITOR_EVALUATION_INTERVAL_SECONDS=60

# Collector health: stale after N minutes without a successful run (0 disables), failing after N failed runs.
MONITOR_COLLECTOR_STALE_AFTER_MINUTES=15
MONITOR_COLLECTOR_FAILURE_THRESHOLD=3

MONITOR_MAX_CLOCK_SKEW_SECONDS=300

# Baseline ("normal level") rule: learns per service/issue and hour of day how many people normally complain.
# Needs MIN_HISTORY_DAYS of data; until then only the fixed thresholds work.
MONITOR_BASELINE_ENABLED=true
MONITOR_BASELINE_HISTORY_DAYS=14
MONITOR_BASELINE_MIN_HISTORY_DAYS=7
MONITOR_BASELINE_WINDOWS_MINUTES=5,15
# warning:critical
MONITOR_BASELINE_MIN_USERS=4:8
MONITOR_BASELINE_P_VALUES=0.001:0.00001
MONITOR_BASELINE_MIN_EXPECTED_USERS=0.1

# Reputation / deposit-risk signal (separate alert type, never an automatic external action). warning:critical
MONITOR_REPUTATION_ENABLED=true
MONITOR_REPUTATION_WINDOW_MINUTES=60
MONITOR_REPUTATION_MIN_USERS=3:10
MONITOR_REPUTATION_AMPLIFICATION=50:500

# Emerging topics (analyst hint, no alarms)
MONITOR_TOPICS_WINDOW_MINUTES=120
MONITOR_TOPICS_HISTORY_DAYS=7
MONITOR_TOPICS_MIN_USERS=3

# Dashboard. There is no login: actions (acknowledge/resolve/notes/labels) are accepted
# local = only from this computer, api_key = with the X-API-Key, off = read-only dashboard.
MONITOR_DASHBOARD_ENABLED=true
MONITOR_DASHBOARD_ACTIONS=local
# Host names this server answers to. Required when MONITOR_HOST is not 127.0.0.1/localhost.
# MONITOR_ALLOWED_HOSTS=monitor.example.internal
